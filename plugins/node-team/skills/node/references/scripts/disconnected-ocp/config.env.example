# Copy this file to config.env and fill in YOUR paths, or just run
# install-disconnected-ocp.sh once and answer the interactive prompts —
# it will create config.env for you automatically.
#
#   cp config.env.example config.env
#   $EDITOR config.env
#
# config.env is per-user/per-machine. Do NOT commit it to git — it's
# already listed in .gitignore.

# Path to your OpenShift pull secret (download from
# https://console.redhat.com/openshift/install/pull-secret)
PULL_SECRET_PATH="$HOME/.openshift/pull-secret.json"

# Path to your GCP service account JSON key (used by openshift-install
# to provision GCP infra). Ask your GCP project admin if you don't have one.
GCP_SA_KEY_PATH="$HOME/.gcp/osServiceAccount.json"

# Path to your SSH PUBLIC key (the .pub file) — gets installed onto every
# cluster node's `core` user for debugging access.
SSH_PUBLIC_KEY_PATH="$HOME/.ssh/id_ed25519.pub"

# Path to a locally-downloaded mirror-registry.tar.gz. This file has NO
# public download URL — you must log in and download it yourself from
# https://console.redhat.com/openshift/downloads (search "mirror registry").
MIRROR_REGISTRY_TARBALL_PATH="$HOME/Downloads/mirror-registry.tar.gz"

# --- Optional overrides (defaults are fine for most runs) -------------------
# PROJECT="openshift-qe"
# REGION="us-central1"
# ZONES="us-central1-a us-central1-b us-central1-c us-central1-f"
# CLUSTER_NAME="yourname-dc"   # defaults to "$(whoami)-dc" if unset
# MACHINE_TYPE="n2-standard-8"
# MIRROR_INIT_USER="init"
# MIRROR_INIT_PASSWORD="ChangeMe2026!"
