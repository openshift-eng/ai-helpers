+"""Sample audit metadata survives aggregation without affecting scoring."""
+import json
+
+import pytest
+import yaml
+
+import score
+from agent_eval.config import EvalConfig, JudgeConfig
+
+
+@pytest.mark.parametrize('values,expected,errors', [
+    ([True, True, True], True, 0),
+    ([True, False, True], True, 0),
+    ([True, 'error', True], True, 1),
+    ([True, 'error', False], False, 1),
+    (['error', 'error', 'error'], None, 3),
+    ([1, 99, 2], 1, 1),
+])
+def test_sample_metadata_preserves_associations_and_aggregate(tmp_path, values, expected, errors):
+    config = EvalConfig(name='t', skill='t')
+    numeric = values == [1, 99, 2]
+    config.judges = [JudgeConfig(name='j', samples=3,
+                                feedback_type='int' if numeric else 'bool',
+                                score_range=[0, 2] if numeric else None)]
+    case = tmp_path / 'case-001'
+    case.mkdir()
+    calls = []
+    usages = []
+
+    def scorer(outputs=None):
+        idx = len(calls)
+        calls.append(idx)
+        # A custom scorer can report multiple requests in one usage dict.
+        usage = {'id': f'gen-{idx}', 'model': 'mock', 'provider': 'mock',
+                 'requests': 2 if idx == 0 else 1,
+                 'prompt_tokens': 10 + idx, 'completion_tokens': idx + 1,
+                 'cost_usd': None, 'cost_source': 'none'}
+        usages.append(usage)
+        if values[idx] == 'error':
+            score._record_judge_usage(usage)
+            raise ValueError(f'parse error {idx}')
+        return score.JudgeOutcome(values[idx], f'rationale {idx}', usage=usage)
+
+    result = score.score_cases([('j', scorer, '', 'llm', 3)], [case], config)
+    entry = result['per_case']['case-001']['j']
+    assert calls == [0, 1, 2]
+    assert entry['value'] == expected
+    assert entry['stability']['error_count'] == errors
+    samples = entry['sample_results']
+    assert len(samples) == 3
+    for idx, sample in enumerate(samples):
+        assert sample['usage'] == usages[idx]
+        assert sample['value'] == (None if values[idx] == 'error' else values[idx])
+        assert sample['rationale'] == ('' if values[idx] == 'error' else f'rationale {idx}')
+        assert ('error' in sample) == (values[idx] == 'error' or numeric and idx == 1)
+    assert entry['usage']['requests'] == 4
+    assert entry['usage']['prompt_tokens'] == 33
+    assert result['judge_usage']['requests'] == 4
+    assert result['judge_usage']['prompt_tokens'] == 33
+    if expected is not None:
+        expected_rationale = 'rationale 2' if expected is False else 'rationale 0'
+        assert entry['rationale'] == expected_rationale
+    # Summary serialization preserves the associated metadata without custom types.
+    assert yaml.safe_load(yaml.safe_dump(entry)) == entry
+    assert json.loads(json.dumps(entry)) == entry
+
+
+@pytest.mark.parametrize("third,errors", [(None, 1), (False, 0)])
+def test_provider_bool_parse_error_retains_usage_without_becoming_a_vote(
+        tmp_path, monkeypatch, third, errors):
+    from types import SimpleNamespace
+
+    config = EvalConfig(name='t', skill='t')
+    config.judges = [JudgeConfig(name='j', samples=3, feedback_type='bool')]
+    case = tmp_path / 'case-001'
+    case.mkdir()
+    requests = []
+
+    def create(**kwargs):
+        idx = len(requests)
+        requests.append(kwargs)
+        value = [True, True, third][idx]
+        content = [] if value is None else [SimpleNamespace(
+            type='tool_use', name='submit_evaluation',
+            input={'passed': value, 'rationale': f'valid {value}'})]
+        return SimpleNamespace(content=content, id=f'gen-{idx}', model='mock',
+                               usage=SimpleNamespace(input_tokens=10 + idx,
+                                                     output_tokens=20))
+
+    monkeypatch.setattr(score, '_get_anthropic_client', lambda: SimpleNamespace(
+        messages=SimpleNamespace(create=create)))
+
+    def scorer(outputs=None):
+        return score._call_structured_judge('fixed prompt', 'mock', 'bool')
+
+    result = score.score_cases([('j', scorer, '', 'llm', 3)], [case], config)
+    entry = result['per_case']['case-001']['j']
+    assert entry['value'] is True
+    assert entry['stability']['error_count'] == errors
+    assert entry['stability']['values'] == ([True, True] if errors else [True, True, False])
+    sample = entry['sample_results'][2]
+    assert sample['value'] is third
+    assert ('error' in sample) == bool(errors)
+    assert sample['usage']['id'] == 'gen-2'
+    assert entry['usage']['requests'] == 3
+    assert result['judge_usage']['prompt_tokens'] == 33
+    assert len(requests) == 3 and requests[0] == requests[1] == requests[2]
