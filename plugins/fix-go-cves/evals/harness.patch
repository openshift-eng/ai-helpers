+def test_stage_aggregation_preserves_any_nonzero_case_exit(tmp_path):
+    """A signed timeout must not disappear beside a successful case."""
+    import contextlib
+    import importlib.util
+    import io
+    import json
+    from types import SimpleNamespace
+
+    import pytest
+    from agent_eval.agent.base import RunResult
+    from agent_eval.config import EvalConfig
+
+    spec = importlib.util.spec_from_file_location('stage_exit_control', EXECUTE)
+    execute = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(execute)
+    config_path = tmp_path / 'eval.yaml'
+    config_path.write_text('name: exit-control\nexecution:\n  mode: case\n  skill: control:control\nmodels:\n  skill: unused\ndataset:\n  path: cases\n')
+    config = EvalConfig.from_yaml(config_path)
+    for number, statuses in enumerate(((-1, 0), (-1, -1), (1, 0), (0, 0))):
+        workspace = tmp_path / str(number)
+        for case in ('case-001', 'case-002'):
+            (workspace / 'cases' / case).mkdir(parents=True)
+        (workspace / 'case_order.yaml').write_text('- case-001\n- case-002\n')
+        output = tmp_path / f'result-{number}'
+        output.mkdir()
+
+        class Runner:
+            name, version = 'control', 'control'
+
+            def execute(self, **kwargs):
+                index = int(kwargs['workspace'].name[-1]) - 1
+                return RunResult(statuses[index], '', 'control', 0.01)
+
+        args = SimpleNamespace(workspace=str(workspace), config=str(config_path),
+                               run_id='control', input_override=None)
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            with pytest.raises(SystemExit) as stopped:
+                execute._execute_per_case(args, config, Runner(), Runner, output,
+                                          0, .2, 'unused', None, target='control:control')
+        recorded = json.loads((output / 'run_result.json').read_text())
+        assert [recorded['per_case'][case]['exit_code'] for case in ('case-001', 'case-002')] == list(statuses)
+        assert (stopped.value.code == 0) == all(status == 0 for status in statuses)
+        assert (recorded['exit_code'] == 0) == all(status == 0 for status in statuses)
